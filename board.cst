// Tang Nano 9K Generic Constraints File
// Note: vctx components typically have an implicit `clk` and `reset`

// System Clock (27 MHz)
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// User Button (used as reset)
IO_LOC "rst" 3;
IO_PORT "rst" IO_TYPE=LVCMOS18;

// 6 On-board LEDs
// Mapping our single `led` output to the first on-board LED (pin 10)
IO_LOC "led" 10;
IO_PORT "led" IO_TYPE=LVCMOS18;
