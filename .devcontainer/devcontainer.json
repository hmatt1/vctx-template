{
    "name": "vctx-lang Environment",
    "image": "ghcr.io/hmatt1/vctx-lang:latest",
    
    "runArgs": ["--entrypoint", "/bin/sh"],
    "overrideCommand": true,

    "postCreateCommand": "sudo cp .devcontainer/vctx /usr/local/bin/vctx && sudo chmod +x /usr/local/bin/vctx",
    "postStartCommand": "/usr/local/bin/vctx lsp &",

    "customizations": {
        "vscode": {
            "extensions": [
                ".devcontainer/vctx-language-support.vsix"
            ],
            "settings": {
                "editor.formatOnSave": true
            }
        }
    },
    
    "remoteUser": "root"
}
