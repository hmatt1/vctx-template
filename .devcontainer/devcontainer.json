{
    "name": "vctx-lang Environment",
    "image": "ghcr.io/hmatt1/vctx-lang:latest",
    
    "runArgs": ["--entrypoint", "/bin/sh"],
    "overrideCommand": true,

    "postCreateCommand": "cp .devcontainer/vctx /usr/local/bin/vctx && chmod +x /usr/local/bin/vctx",
    "postStartCommand": "/usr/local/bin/vctx lsp &",
    "postAttachCommand": "code --install-extension .devcontainer/vctx-language-support.vsix --force",

    "customizations": {
        "vscode": {
            "extensions": [],
            "settings": {
                "editor.formatOnSave": true
            }
        }
    },
    
    "remoteUser": "root"
}
