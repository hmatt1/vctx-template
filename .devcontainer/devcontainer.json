{
    "name": "vctx-lang Environment",
    "image": "ghcr.io/hmatt1/vctx-lang:latest",
    
    "runArgs": ["--entrypoint", "/bin/sh"],
    "overrideCommand": true,

    "postCreateCommand": "echo -e '#!/bin/sh\\npython3.14t -X gil=0 /app/vctx-cli.py \"$@\"' > /usr/local/bin/vctx && chmod +x /usr/local/bin/vctx",

    "customizations": {
        "vscode": {
            "extensions": [
                ".devcontainer/vctx-language-support.vsix"
            ],
            "settings": {
                "editor.formatOnSave": true
            }
        }
    },
    
    "remoteUser": "root"
}
